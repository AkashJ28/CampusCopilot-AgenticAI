# =====================================================================
# Campus Copilot — Root Environment Example
# Copy this file to .env and fill in your values.
# See ai-agent/.env.example and backend/.env.example for service-level vars.
# =====================================================================

# -- Backend (Node.js) ----------------------------------------------
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/campus_copilot"
JWT_SECRET="your-very-long-random-secret-string-at-least-32-chars"
AI_AGENT_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"

# -- AI Agent (Python / FastAPI) ------------------------------------
AZURE_OPENAI_API_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-05-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1"
AZURE_OPENAI_MODEL_NAME="gpt-4.1"
NODE_API_BASE_URL="http://localhost:3001"

# -- Frontend (React) -----------------------------------------------
REACT_APP_API_URL="http://localhost:3001"
