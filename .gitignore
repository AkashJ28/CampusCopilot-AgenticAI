# =================================================================
# ENVIRONMENT & SECRETS — NEVER COMMIT THESE
# =================================================================
.env
.env.*
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.env

# Never ignore example env templates
!.env.example
!.env*.example
!**/.env.example
!**/.env*.example

# Specific env files per service
backend/.env
frontend/.env
ai-agent/.env

# Credential / secret files — NEVER commit these
creds
creds.*
**/creds
**/creds.*
credentials*
**/credentials*
*.pem
*.key
*.cert
*.p12
*.pfx
*service-account*.json
id_rsa*
id_ed25519*

# =================================================================
# DATABASE FILES (schema & seed data — contains passwords)
# =================================================================
db.sql
populate_db.sql
**/db.sql
**/populate_db.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
dump*.sql
backup*.sql

# =================================================================
# PYTHON
# =================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/
dist/
build/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
.env/
ai-agent/venv/
backend/venv/
frontend/venv/

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# =================================================================
# NODE / JAVASCRIPT
# =================================================================
node_modules/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# =================================================================
# BUILD OUTPUT
# =================================================================
frontend/build/
frontend/.next/
frontend/out/
dist/
.cache/

# =================================================================
# LOGS & TEMPORARY FILES
# =================================================================
*.log
logs/
*.tmp
*.bak
*.swp
*.swo

# =================================================================
# RESEARCH / BENCHMARK DATA (large generated files)
# =================================================================
