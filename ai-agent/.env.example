# Copy this file to .env and fill in your values
# DO NOT commit your actual .env file

# Azure OpenAI Service Credentials
AZURE_OPENAI_API_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-05-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME="your-deployment-name"
AZURE_OPENAI_MODEL_NAME="your-model-name"

# Backend API
NODE_API_BASE_URL="http://localhost:3001"
